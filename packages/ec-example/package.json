{
  "name": "ec-example",
  "version": "1.0.0",
  "description": "ECサイトのバックエンド例",
  "author": "木村 彰宏",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimutyam/backend-ts-hands-on.git",
    "directory": "packages/ec-example"
  },
  "homepage": "https://github.com/kimutyam/backend-ts-hands-on#readme",
  "bugs": {
    "url": "https://github.com/kimutyam/backend-ts-hands-on/issues"
  },
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./dist/*"
  },
  "scripts": {
    "prebuild": "rimraf dist tsconfig.tsbuildinfo",
    "build": "tsc --build tsconfig.json",
    "format": "prettier --check \"{src,test}/**/*.ts\"",
    "format:fix": "prettier --write \"{src,test}/**/*.ts\"",
    "lint": "eslint --cache \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint --cache \"{src,test}/**/*.ts\" --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv run -f .env.local -- drizzle-kit migrate",
    "db:push": "dotenv run -f .env.local -- drizzle-kit push",
    "shopping:start": "dotenv run -f .env.local -- node dist/entryPoint/primary/shopping/web/main.js",
    "management:register-product": "dotenv run -f .env.local -- node dist/entryPoint/primary/management/cli/registerProduct.js",
    "test": "dotenv run -f .env.test -- vitest --typecheck",
    "test:cov": "dotenv run -f .env.test -- vitest --coverage",
    "test:db": "dotenv run -f .env.test.db -- vitest --no-file-parallelism",
    "test:db:migrate": "dotenv run -f .env.test.db -- drizzle-kit migrate",
    "test:db:push": "dotenv run -f .env.test.db -- drizzle-kit push"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@scalar/hono-api-reference": "0.12.14",
    "date-fns": "4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "4.13.14",
    "neverthrow": "8.2.0",
    "pg": "8.23.1",
    "remeda": "2.55.0",
    "typed-inject": "5.0.0",
    "ulidx": "2.4.1",
    "yargs": "18.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/yargs": "17.0.35",
    "@vitest/coverage-v8": "4.1.12",
    "@vitest/ui": "4.1.12",
    "dotenv": "18.0.9",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint-plugin-neverthrow": "1.1.4",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "rimraf": "6.1.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.12"
  }
}
